---
import Icon from "@src/components/Icons.astro";

const getVariant = (variant: string) => {
	switch (variant) {
		case "github":
			return `bg-primary text-bg hover:bg-accent hover:border-accent`;
		case "accent":
			return `bg-accent text-white dark:text-gray-900 border-accent`;
		default:
			return `bg-transparent text-primary hover:bg-primary hover:text-bg`;
	}
};
const {
	text,
	icon,
	href = "#",
	variant = "",
}: {
	text?: string;
	icon?: string;
	href?: string;
	variant?: string;
} = Astro.props;
---

<a
	href={href}
	class:list={[
		"focus:ring-accent border-primary inline-flex items-center justify-center gap-2 rounded-none border-2 px-6 py-3 text-sm font-bold transition-all duration-300 hover:-translate-y-1 hover:shadow-[4px_4px_0_var(--color-primary)] focus:ring-2 focus:outline-hidden",
		getVariant(variant),
	]}
>
	{text}
	{icon && <Icon name={icon} class="h-4 w-4" />}
</a>
