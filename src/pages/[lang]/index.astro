---
import BaseLayout from "@src/layouts/BaseLayout.astro";
import Icon from "@src/components/Icons.astro";
import Projects from "@src/components/Projects.astro";
import { useTranslations } from "@src/lib/i18n";
import { Lang, LOCALES } from "@src/lib/locales";
import { LINKEDIN_PROFILE_URL } from "@src/lib/consts";

const locale = Astro.currentLocale as Lang;
const { t } = useTranslations(locale);

export const getStaticPaths = () =>
	Object.keys(LOCALES).map((lang) => ({
		params: { lang },
	}));

const squiggleWidth = 18;
const squiggleHeight = 4;

const getSquigglySvg = (width: number, height: number) => {
	const halfH = height / 2;
	const qW = width / 4;
	const viewBoxWidth = width + 2;
	const path = `M -1 ${halfH} Q ${qW} ${height + 0.5}, ${width / 2} ${halfH} T ${width + 1} ${halfH}`;
	const svgString = `<svg width='${width}' height='${height}' viewBox='-1 0 ${viewBoxWidth} ${height}' xmlns='http://www.w3.org/2000/svg'><path d='${path}' fill='none' stroke='black' stroke-width='2'/></svg>`;

	return `url("data:image/svg+xml,${encodeURIComponent(svgString)}")`;
};
---

<BaseLayout class="bg-element overflow-x-hidden">
	<section
		class="animate-fade-in relative my-[clamp(--spacing(4),4vw,--spacing(16))] flex min-h-[70vh] flex-col justify-center p-[clamp(--spacing(4),4vw,--spacing(32))]"
	>
		<div
			class="text-primary/5 md:text-primary/10 absolute top-1/2 right-0 -z-10 h-[90%] w-auto -translate-y-1/2 transition-colors"
		>
			<Icon name="jasper-impression" class="h-full w-auto object-contain" />
		</div>

		<div class="relative z-10 w-full flex-col justify-between">
			<span
				class="animate-slide-up flex flex-wrap-reverse items-center justify-between 2xl:justify-start"
			>
				<h1
					class="text-primary flex text-[clamp(4.5rem,10vw,8rem)] leading-tight font-bold tracking-tight"
				>
					Jasper Albering
				</h1>

				<Icon
					name="logo"
					class="text-primary flex h-[clamp(6.5rem,20vw,8rem)] w-[clamp(6.5rem,20vw,8rem)] transition-transform 2xl:ml-8"
					aria-label="Jasper Albering Logo"
				/>
			</span>
			<span
				class="animate-slide-up my-12 block max-w-4xl space-y-6 text-lg leading-relaxed md:text-xl"
			>
				{
					t({
						en: (
							<>
								<p class="text-accent text-sm font-bold tracking-widest uppercase opacity-90">
									Introduction
								</p>
								<p>Hello, I'm Jasper.</p>
								<p>
									I am a software developer at{" "}
									<a
										href="https://levarne.nl"
										target="_blank"
										rel="noopener noreferrer"
										class="link-squiggle text-accent font-bold"
									>
										Levarne
									</a>
									, where I build full-stack applications. I work
									across both the frontend and backend using
									TypeScript, Vue / Nuxt, and modern cloud
									architectures.
								</p>
								<p>
									I enjoy tinkering and understanding how systems work
									from the ground up. In my spare time, I work with
									Linux, home automation, networking, and electronics.
								</p>
							</>
						),
						nl: (
							<>
								<p class="text-accent text-sm font-bold tracking-widest uppercase opacity-90">
									Introductie
								</p>
								<p>Hoi, ik ben Jasper.</p>
								<p>
									Ik ben softwareontwikkelaar bij{" "}
									<a
										href="https://levarne.nl"
										target="_blank"
										rel="noopener noreferrer"
										class="link-squiggle text-accent font-bold"
									>
										Levarne
									</a>
									, waar ik full-stack applicaties bouw. Ik werk aan
									zowel de front-end als back-end met TypeScript, Vue /
									Nuxt en moderne cloud-architecturen.
								</p>
								<p>
									Ik hou ervan om te sleutelen en te doorgronden hoe
									systemen precies werken. In mijn vrije tijd ben ik
									veel bezig met Linux, domotica, netwerken en
									elektronica.
								</p>
							</>
						),
					})
				}
			</span>

			<div
				class="animate-slide-up mt-8 flex w-max max-w-full flex-wrap gap-4"
			>
				<a
					href={LINKEDIN_PROFILE_URL}
					class="bg-accent border-primary flex w-full items-center justify-center rounded-none border-2 px-8 py-4 text-sm font-bold text-white transition-all hover:-translate-y-1 hover:shadow-[4px_4px_0_var(--color-primary)] sm:w-max dark:text-gray-900"
					>{t({ en: "View my resume", nl: "Bekijk mijn cv" })}&nbsp;<Icon
						name="linkedin"
						class="h-4 w-4"
					/>
				</a>
				<a
					href="https://github.com/jasperro"
					class="border-primary bg-primary text-bg flex w-max items-center rounded-none border-2 px-4 py-4 transition-all hover:-translate-y-1 hover:shadow-[4px_4px_0_var(--color-primary)]"
					aria-label="GitHub Profile"
				>
					<Icon name="github" class="h-6 w-6" />
				</a>
			</div>
		</div>
	</section>

	<section
		class="animate-slide-up px-[clamp(--spacing(4),4vw,--spacing(32))] pb-24"
	>
		<h2
			class="text-accent mb-12 text-sm font-bold tracking-widest uppercase opacity-80"
		>
			{t({ en: "Expertise", nl: "Expertise" })}
		</h2>
		<div class="flex flex-wrap gap-4 md:gap-6">
			{
				[
					{ name: "Full-Stack Development" },
					{ name: "TypeScript & Vue" },
					{ name: "Linux & Networking" },
					{ name: "Electronics & Domotics" },
				].map((skill) => (
					<div class="border-primary text-primary hover:bg-primary hover:text-bg cursor-default rounded-none border-2 bg-transparent px-8 py-4 text-lg font-bold tracking-widest uppercase transition-colors duration-300 md:text-xl">
						{skill.name}
					</div>
				))
			}
		</div>
	</section>

	<Projects locale={locale} />
</BaseLayout>

<style
	define:vars={{
		squiggleSvg: getSquigglySvg(squiggleWidth, squiggleHeight),
		squiggleWidth: `${squiggleWidth}px`,
		squiggleHeight: `${squiggleHeight}px`,
	}}
>
	.link-squiggle {
		position: relative;
		white-space: nowrap;
	}

	.link-squiggle::after {
		content: "";
		position: absolute;
		left: 0;
		bottom: -4px;
		width: 100%;
		height: var(--squiggleHeight);
		background-color: var(--color-accent);
		-webkit-mask-image: var(--squiggleSvg);
		mask-image: var(--squiggleSvg);
		-webkit-mask-size: var(--squiggleWidth) var(--squiggleHeight);
		mask-size: var(--squiggleWidth) var(--squiggleHeight);
		-webkit-mask-repeat: repeat-x;
		mask-repeat: repeat-x;
		-webkit-mask-position: 0 0;
		mask-position: 0 0;
		transition: -webkit-mask-position 0.5s cubic-bezier(0.25, 1, 0.5, 1);
		transition: mask-position 0.5s cubic-bezier(0.25, 1, 0.5, 1);
	}

	.link-squiggle:hover::after {
		-webkit-mask-position: var(--squiggleWidth) 0;
		mask-position: var(--squiggleWidth) 0;
	}
</style>
